{
  "version": "0.0.0",
  "name": "CHANGE_ME",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "lint": "eslint --ext js,jsx,ts,tsx .",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json}\"",
    "lint:locales": "intl-equalizer",
    "test": "cd ./react && yarn test"
  },
  "intl-equalizer": {
    "referenceLocale": "en",
    "localeDirectory": "messages"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{ts,js,tsx,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.json": [
      "prettier --write"
    ],
    "messages/*.json": [
      "yarn lint:locales"
    ]
  },
  "devDependencies": {
    "@vtex/intl-equalizer": "^2.5.0",
    "@vtex/prettier-config": "^0.3.5",
    "eslint": "^7.14.0",
    "eslint-config-vtex": "^12.8.11",
    "eslint-config-vtex-react": "^6.8.3",
    "husky": "^4.3.0",
    "lint-staged": "^10.5.1",
    "prettier": "^2.2.0",
    "typescript": "^3.9.6",
    "@vtex/danger": "^0.2.7"
  },
  "resolutions": {
    "@actions/core": "1.11.1",
    "@octokit/plugin-paginate-rest": "9.2.2",
    "@octokit/request": "8.4.1",
    "@octokit/request-error": "5.1.1",
    "ansi-regex": "5.0.1",
    "brace-expansion": "1.1.22",
    "braces": "3.0.3",
    "cross-spawn": "7.0.6",
    "danger": "13.0.10",
    "debug": "4.4.3",
    "decode-uri-component": "0.5.1",
    "flatted": "3.4.4",
    "form-data": "2.5.6",
    "glob-parent": "5.1.2",
    "hosted-git-info": "2.8.9",
    "js-yaml": "3.15.2",
    "json-schema": "0.4.0",
    "json5": "2.2.3",
    "jsonpointer": "5.0.1",
    "jsonwebtoken": "9.0.3",
    "jws": "3.2.3",
    "lodash": "4.18.1",
    "marked": "4.3.0",
    "micromatch": "4.0.8",
    "minimatch": "3.1.5",
    "minimist": "1.2.8",
    "node-fetch": "2.7.0",
    "nth-check": "2.1.1",
    "parse-link-header": "2.0.0",
    "path-parse": "1.0.7",
    "picomatch": "2.3.2",
    "qs": "6.17.1",
    "semver": "7.8.6",
    "semver-regex": "3.1.4",
    "tough-cookie": "4.1.4",
    "uuid": "11.1.1",
    "word-wrap": "1.2.5"
  }
}
